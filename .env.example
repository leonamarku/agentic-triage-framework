# Copy this file to .env and fill in your values
# Never commit .env to version control


GROQ_API_KEY=your_groq_api_key_here

# Optional: LLM model to use (default is a fast, capable model)
# NOTE: llama-3.1-8b-instant, llama-3.3-70b-versatile, and mixtral-8x7b-32768
#       were all decommissioned by Groq (shutdown Aug 16, 2026). Use current models:
# Options: openai/gpt-oss-20b   (fastest, cheapest — replaces llama-3.1-8b-instant)
#          openai/gpt-oss-120b  (best quality — replaces llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: dataset path (default assumes data/ in project root)
DATASET_PATH=data/Support_tickets.csv

# Optional: application settings
APP_ENV=development
LOG_LEVEL=INFO
